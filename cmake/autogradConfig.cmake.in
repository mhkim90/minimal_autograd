# autograd package configuration.
#
# This file is installed to <prefix>/lib/cmake/autograd/autogradConfig.cmake.
# It is the entry point used by `find_package(autograd)` in downstream
# projects. The normal target intentionally has no Eigen dependency in this
# file. Eigen and the legacy CUDA boundary are opt-in through COMPONENTS
# expert.
#
# API version is reserved for the Phase 11 freeze; this file intentionally
# accepts unversioned `find_package(autograd)` calls.

include(CMakeFindDependencyMacro)

# Reject components that this package does not define before discovering any
# optional dependency. This also makes REQUIRED unknown components fail via
# the normal find_package(CONFIG) contract.
foreach(_autograd_component IN LISTS autograd_FIND_COMPONENTS)
    if(NOT _autograd_component STREQUAL "expert")
        set(autograd_FOUND FALSE)
        set(autograd_NOT_FOUND_MESSAGE
            "autograd does not provide component '${_autograd_component}'")
        return()
    endif()
endforeach()

set(_AUTOGRAD_REQUEST_EXPERT FALSE)
foreach(_autograd_component IN LISTS autograd_FIND_COMPONENTS)
    if(_autograd_component STREQUAL "expert")
        set(_AUTOGRAD_REQUEST_EXPERT TRUE)
    endif()
endforeach()

# Set the per-feature flag variables when the matching feature was enabled
# at install time. The parent project substitutes an empty value when a
# feature was OFF, leaving the flag undefined and the corresponding
# find_dependency() block below a no-op.
@autograd_extra_deps@

if(_AUTOGRAD_HAS_OPENMP)
    find_dependency(OpenMP)
endif()

# Static CUDA archives need cudart at the final consumer link. A shared
# autograd library records cudart in its own DT_NEEDED list, so its normal
# consumer must not discover the CUDA toolkit. The expert component may still
# request cudart explicitly for legacy/custom CUDA consumers.
if(_AUTOGRAD_HAS_CUDA AND
   (NOT _AUTOGRAD_IS_SHARED OR _AUTOGRAD_REQUEST_EXPERT))
    find_dependency(CUDAToolkit REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/autogradTargets.cmake")

if(_AUTOGRAD_REQUEST_EXPERT)
    find_dependency(Eigen3 REQUIRED)
    include("${CMAKE_CURRENT_LIST_DIR}/autogradExpertTargets.cmake")
endif()
